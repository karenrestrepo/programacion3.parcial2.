<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.programacion3.parcial2.parcial2.Ejercicio1.Controller.AsignacionController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <GridPane hgap="10" vgap="10">
         <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
         </rowConstraints>
         <children>
            <Label text="Empleado:" />
            <ComboBox fx:id="cmbEmpleado" prefWidth="200.0" GridPane.columnIndex="1" />
            <Label text="Departamento:" GridPane.rowIndex="1" />
            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1">
               <children>
                  <ComboBox fx:id="cmbDepartamento" prefWidth="200.0" />
               </children>
            </HBox>
            <Label text="Proyecto:" GridPane.rowIndex="2" />
            <ComboBox fx:id="cmbProyecto" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
         </children>
      </GridPane>
      <TableView fx:id="tblProductosSeleccionados" prefHeight="200.0">
         <columns>
            <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Empleado" />
            <TableColumn fx:id="colNombre" prefWidth="200.0" text="Departamento" />
            <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Proyecto" />
         </columns>
      </TableView>
      <HBox alignment="CENTER_RIGHT" spacing="10" />
      <Button onAction="#realizarPedido" text="Asignar" />
   </children>
</VBox>
